<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<system xmlns="adtf/xsd/system">
  <file_version>
    <major>1</major>
    <minor>0</minor>
  </file_version>
  <name>System configuration</name>
  <description/>
  <environment/>
  <dependencies>
    <platform>
      <name>windows_x86_64</name>
      <libraries/>
    </platform>
    <platform>
      <name>windows_x86_64_release</name>
      <libraries/>
