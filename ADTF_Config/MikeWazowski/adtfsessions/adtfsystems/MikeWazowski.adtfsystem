      <url>$(ADTF_DIR)/bin/default_core_objects.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_QT5_DIR)/bin/adtf_xsystem.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_QT5_DIR)/bin/demo_qt_media_description_display.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_QT5_DIR)/bin/adtf_sample_stream_trace_view_ui.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_QT5_DIR)/bin/adtf_log_view.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/foreign_application_udp.adtfplugin</url>
    </plugin>
  </plugins>
  <debug_plugins>
    <plugin>
      <url>$(ADTF_DIR)/bin/debug/adtf_clock.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/debug/adtf_kernel.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/packet_parser_filter.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/debug/adtf_playback.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/debug/adtf_playback_input.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/debug/default_core_objects.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_QT5_DIR)/bin/debug/adtf_xsystem.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_QT5_DIR)/bin/debug/demo_qt_media_description_display.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_QT5_DIR)/bin/debug/adtf_sample_stream_trace_view_ui.adtfplugin</url>
