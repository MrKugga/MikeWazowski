    <platform>
      <name>linux_x86_64</name>
      <libraries/>
    </platform>
    <platform>
      <name>linux_x86_64_release</name>
      <libraries>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5Core.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5DBus.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5Gui.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5Xml.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5Widgets.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5Svg.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5Network.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5Multimedia.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5SerialPort.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5SerialBus.so</url>
        </library>
        <library>
          <url>$(QT5_INSTALL_DIR)/lib/libQt5OpenGL.so</url>
        </library>
      </libraries>
    </platform>
    <platform>
      <name>linux_x86_64_debug</name>
      <libraries/>
    </platform>
    <platform>
      <name>linux_aarch64</name>
      <libraries/>
    </platform>
    <platform>
      <name>linux_aarch64_release</name>
      <libraries/>
    </platform>
    <platform>
      <name>linux_aarch64_debug</name>
      <libraries/>
    </platform>
  </dependencies>
  <plugins>
    <plugin>
      <url>$(ADTF_DIR)/bin/adtf_clock.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/adtf_kernel.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/packet_parser_filter.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/adtf_playback.adtfplugin</url>
    </plugin>
