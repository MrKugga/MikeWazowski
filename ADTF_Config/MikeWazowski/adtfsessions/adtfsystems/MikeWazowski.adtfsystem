      <url>$(ADTF_QT5_DIR)/bin/debug/adtf_log_view.adtfplugin</url>
    </plugin>
    <plugin>
      <url>$(ADTF_DIR)/bin/debug/foreign_application_udp.adtfplugin</url>
    </plugin>
  </debug_plugins>
  <services>
    <service>
      <classid>reference_clock.service.adtf.cid</classid>
      <objectid>Reference Clock Service</objectid>
      <runlevel>system</runlevel>
    </service>
    <service>
      <classid>kernel.service.adtf.cid</classid>
      <objectid>Kernel Service</objectid>
      <runlevel>system</runlevel>
    </service>
    <service>
      <classid>playback.service.adtf.cid</classid>
      <objectid>Playback Service</objectid>
      <runlevel>system</runlevel>
    </service>
    <service>
      <classid>qt_xsystem.ui_service.adtf.cid</classid>
      <objectid>Qt5 ADTF XSystem UI Service</objectid>
      <runlevel>system</runlevel>
    </service>
    <service>
      <classid>sample_stream_trace_view.ui_service.adtf.cid</classid>
      <objectid>Qt5 Sample Stream Trace View UI Service</objectid>
      <runlevel>filtergraph</runlevel>
    </service>
    <service>
      <classid>log_view.ui_service.adtf.cid</classid>
      <objectid>Qt5 Log View UI Service</objectid>
      <runlevel>system</runlevel>
    </service>
  </services>
  <adtf_file_plugins/>
  <debug_adtf_file_plugins/>
</system>
